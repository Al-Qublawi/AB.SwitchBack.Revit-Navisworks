<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ABSwitchBack.Core</AssemblyName>
    <RootNamespace>ABSwitchBack.Core</RootNamespace>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    Lets the self-test reach implementation details worth covering directly, without
    widening the public API just to make them testable.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="ABSwitchBack.SelfTest" />
  </ItemGroup>
</Project>
