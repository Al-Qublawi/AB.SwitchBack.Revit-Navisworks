<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Built once per Revit release:  dotnet build -p:RevitVersion=2024 -p:RevitApiDir="<install>"
    RevitApiDir is discovered at build time (registry first) by build/build.ps1 - never hard-coded.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>

    <!-- Revit 2020-2024 run on .NET Framework; 2025+ run on .NET 8. -->
    <TargetFramework Condition="'$(RevitVersion)' &lt; '2025'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2025'">net8.0-windows</TargetFramework>

    <AssemblyName>ABSwitchBack.Revit</AssemblyName>
    <RootNamespace>ABSwitchBack.Revit</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <OutputPath>$(RepoRoot)artifacts\Revit\$(RevitVersion)\</OutputPath>

    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>

  <!-- ElementId became 64-bit in Revit 2024; the int overloads were removed in 2025. -->
  <PropertyGroup Condition="'$(RevitVersion)' &gt;= '2024'">
    <DefineConstants>$(DefineConstants);REVIT2024_OR_LATER</DefineConstants>
  </PropertyGroup>

  <!--
    API source: NuGet reference assemblies by default; the installed SDK only when
    RevitApiDir is passed explicitly.

    Building against whatever is installed is NOT reproducible. A Revit 2026 update
    published in September 2026 moved that release from .NET 8 to .NET 10 in place, so the
    same source built on two machines a week apart produced add-ins with different runtime
    requirements - and one built against the updated SDK will not load for anyone who has
    not taken the update. The reference packages pin the baseline API for each year, which
    loads on both original and updated installs.

    It also means the whole matrix builds on a machine with no Autodesk products at all.
    The Autodesk assemblies are NOT redistributable, so none are committed here -
    referencing a public package commits nothing.
  -->
  <PropertyGroup>
    <UseLocalRevitApi>false</UseLocalRevitApi>
    <UseLocalRevitApi Condition="'$(RevitApiDir)' != '' And Exists('$(RevitApiDir)\RevitAPI.dll')">true</UseLocalRevitApi>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalRevitApi)' == 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    ExcludeAssets=runtime keeps the Revit assemblies out of the add-in folder: Revit
    supplies its own, and shipping a second copy is a classic way to break an add-in.
  -->
  <ItemGroup Condition="'$(UseLocalRevitApi)' != 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*"
                      ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*"
                      ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ABSwitchBack.Core\ABSwitchBack.Core.csproj" />
  </ItemGroup>

  <!--
    Icons ride inside the assembly rather than as loose files: the add-in folder sits
    beside the .addin manifest in every user's profile, and keeping it to two DLLs makes
    deployment and troubleshooting far simpler. Sourced straight from assets\ so there is
    one copy of each image in the repository.
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(RepoRoot)assets\logo_16.png">
      <LogicalName>ABSwitchBack.Revit.Resources.logo_16.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(RepoRoot)assets\logo_32.png">
      <LogicalName>ABSwitchBack.Revit.Resources.logo_32.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(RepoRoot)assets\status_16.png">
      <LogicalName>ABSwitchBack.Revit.Resources.status_16.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(RepoRoot)assets\status_32.png">
      <LogicalName>ABSwitchBack.Revit.Resources.status_32.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(RepoRoot)assets\linkedin_16.ico">
      <LogicalName>ABSwitchBack.Revit.Resources.linkedin_16.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(RepoRoot)assets\linkedin_32.ico">
      <LogicalName>ABSwitchBack.Revit.Resources.linkedin_32.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ReportRevitApiSource" BeforeTargets="BeforeBuild">
    <Message Importance="normal" Condition="'$(UseLocalRevitApi)' == 'true'"
             Text="Revit $(RevitVersion): using the installed SDK at $(RevitApiDir)" />
    <Message Importance="normal" Condition="'$(UseLocalRevitApi)' != 'true'"
             Text="Revit $(RevitVersion): not installed here, using NuGet reference assemblies" />
  </Target>

</Project>
