<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Built once per Navisworks release:
      dotnet build -p:NavisVersion=2027 -p:NavisApiDir="<install>"

    Navisworks is still a .NET Framework 4.8 host in every release from 2024 to 2027
    (no hostfxr.dll / runtimeconfig.json in the install), so one TFM covers them all.
    The assembly name must match the plugin folder name: Plugins\ABSwitchBack\ABSwitchBack.dll
  -->
  <PropertyGroup>
    <NavisVersion Condition="'$(NavisVersion)' == ''">2026</NavisVersion>
    <TargetFramework>net48</TargetFramework>

    <AssemblyName>ABSwitchBack</AssemblyName>
    <RootNamespace>ABSwitchBack.Navisworks</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <OutputPath>$(ArtifactsDir)Navisworks\$(NavisVersion)\ABSwitchBack\</OutputPath>
    <DefineConstants>$(DefineConstants);NAVIS$(NavisVersion)</DefineConstants>
  </PropertyGroup>

  <!-- VariantData gained its 64-bit and unsigned accessors in the 2026 release. -->
  <PropertyGroup Condition="'$(NavisVersion)' &gt;= '2026'">
    <DefineConstants>$(DefineConstants);NAVIS2026_OR_LATER</DefineConstants>
  </PropertyGroup>

  <!--
    API source: the installed product when it is on this machine, otherwise NuGet
    reference assemblies, so every supported release can be built on a machine with no
    Autodesk products at all. The Autodesk assemblies are NOT redistributable, so none
    are committed to this repository.
  -->
  <PropertyGroup>
    <UseLocalNavisApi>false</UseLocalNavisApi>
    <UseLocalNavisApi Condition="'$(NavisApiDir)' != '' And Exists('$(NavisApiDir)\Autodesk.Navisworks.Api.dll')">true</UseLocalNavisApi>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalNavisApi)' == 'true'">
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisApiDir)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    ExcludeAssets=runtime keeps the Navisworks assemblies out of the plugin folder:
    Navisworks supplies its own, and a second copy beside the plugin breaks loading.
  -->
  <ItemGroup Condition="'$(UseLocalNavisApi)' != 'true'">
    <PackageReference Include="Speckle.Navisworks.API" Version="$(NavisVersion).*"
                      ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Core is COMPILED IN rather than referenced as a second assembly.

    Navisworks scans a plugin assembly for [Plugin] types before any of our code has run,
    so there is no opportunity to install an AssemblyResolve handler first. If any scanned
    type needs Core to be resolved at that moment - which a value-type field such as the
    TriggerModifiers enum forces, because the CLR must compute the type's layout - the scan
    throws ReflectionTypeLoadException and Navisworks silently loads NO plugins at all: no
    ribbon, no listener, nothing. That is exactly what happened in 1.1.0.

    Shipping one self-contained DLL removes the failure mode completely, whatever load
    context Navisworks uses. Core remains a single shared source tree; only the Navisworks
    build links it in. Revit keeps the project reference, because Revit probes the add-in
    folder for dependencies and has never had this problem.
  -->
  <ItemGroup>
    <Compile Include="$(RepoRoot)src\ABSwitchBack.Core\**\*.cs"
             Exclude="$(RepoRoot)src\ABSwitchBack.Core\obj\**\*.cs;$(RepoRoot)src\ABSwitchBack.Core\bin\**\*.cs"
             LinkBase="Core" />
  </ItemGroup>

  <!--
    AB Adv Tools suite: the shared ribbon tab, About / Check for Updates / LinkedIn panel and
    GitHub release notifications. Compiled in, like Core and for the same reason.
  -->
  <PropertyGroup>
    <ABAdvToolsRibbonXaml>$(MSBuildProjectDirectory)\ABSwitchBack.xaml</ABAdvToolsRibbonXaml>
  </PropertyGroup>
  <Import Project="$(RepoRoot)shared\ABAdvTools\build\ABAdvTools.Navisworks.targets" />

  <!-- Lets the running plugin report which release it was compiled against. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NavisVersion</_Parameter1>
      <_Parameter2>$(NavisVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Navisworks reads the button images as loose files beside the plugin DLL, resolved
    from an Images folder, so they cannot be embedded. Linked from assets\ to keep one
    copy of each image in the repository.
  -->
  <ItemGroup>
    <None Include="$(RepoRoot)assets\logo_16.ico" Link="Images\logo_16.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(RepoRoot)assets\logo_32.ico" Link="Images\logo_32.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(RepoRoot)assets\status_16.ico" Link="Images\status_16.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(RepoRoot)assets\settings_16.ico" Link="Images\settings_16.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(RepoRoot)assets\settings_32.ico" Link="Images\settings_32.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(RepoRoot)assets\status_32.ico" Link="Images\status_32.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Navisworks looks for a plugin's ribbon layout in a LOCALE subfolder beside the
    assembly - en-US\ABSwitchBack.xaml - not in the assembly folder itself. Putting the
    file next to the DLL means the tab silently never appears.
  -->
  <Target Name="CopyRibbonLayout" AfterTargets="Build" Condition="'$(StoreBuild)' != 'true'">
    <Copy SourceFiles="ABSwitchBack.xaml"
          DestinationFolder="$(OutputPath)en-US"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Store build: the same layout without the shared AB Adv Tools panel (About, Check for Updates,
    LinkedIn) - the Marketplace forbids an app's own update mechanism. The panel is cut between
    its BEGIN/END markers, so the source XAML stays the one sync-kit.ps1 maintains, and the build
    fails if the markers are ever lost rather than shipping the update button.
  -->
  <Target Name="CopyStoreRibbonLayout" AfterTargets="Build" Condition="'$(StoreBuild)' == 'true'">
    <PropertyGroup>
      <_RibbonText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\ABSwitchBack.xaml'))</_RibbonText>
      <_StoreRibbonText>$([System.Text.RegularExpressions.Regex]::Replace($(_RibbonText), '[ \t]*&lt;!-- BEGIN AB ADV TOOLS SHARED PANEL[\s\S]*?&lt;!-- END AB ADV TOOLS SHARED PANEL --&gt;\r?\n', ''))</_StoreRibbonText>
    </PropertyGroup>
    <Error Condition="$(_StoreRibbonText.Contains('ABADV_SharedPanel')) Or $(_StoreRibbonText.Contains('ID_ABADV_'))"
           Text="Store build: the shared AB Adv Tools panel could not be removed from ABSwitchBack.xaml (its BEGIN/END markers changed)." />
    <MakeDir Directories="$(OutputPath)en-US" />
    <!-- Escaped, or WriteLinesToFile would split the text at every ';' (the xmlns lines). -->
    <WriteLinesToFile File="$(OutputPath)en-US\ABSwitchBack.xaml" Lines="$([MSBuild]::Escape($(_StoreRibbonText)))" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="utf-8" />
  </Target>

  <Target Name="ReportNavisApiSource" BeforeTargets="BeforeBuild">
    <Message Importance="normal" Condition="'$(UseLocalNavisApi)' == 'true'"
             Text="Navisworks $(NavisVersion): using the installed product at $(NavisApiDir)" />
    <Message Importance="normal" Condition="'$(UseLocalNavisApi)' != 'true'"
             Text="Navisworks $(NavisVersion): not installed here, using NuGet reference assemblies" />
  </Target>

</Project>
