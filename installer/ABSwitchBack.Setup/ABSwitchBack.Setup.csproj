<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AB.SwitchBack.Setup.exe - the AB Adv Tools installer engine (shared\ABAdvTools) plus this
    add-in's definition in SwitchBackSetup.cs. Build it with build\make-installer.ps1, which
    fills payload\ with one zip per Revit and Navisworks release first.

    net48 on purpose: .NET Framework 4.8 is on every machine that can run Revit or Navisworks,
    so the installer needs no runtime of its own.

    Deliberately NOT part of ABSwitchBack.sln: without its payload it builds an installer with
    nothing inside, and Directory.Build.props would stamp it with the add-in version anyway.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AB.SwitchBack.Setup</AssemblyName>
    <RootNamespace>ABSwitchBack.Setup</RootNamespace>
    <ApplicationIcon>$(RepoRoot)assets\logo.ico</ApplicationIcon>
    <OutputPath>$(RepoRoot)artifacts\Setup\</OutputPath>
    <DebugType>none</DebugType>

    <AssemblyTitle>AB SwitchBack Setup</AssemblyTitle>
    <Description>Installs AB SwitchBack for Autodesk Revit and Navisworks.</Description>
    <Company>Abdullah Lotfy</Company>
    <Authors>Abdullah Lotfy</Authors>
    <Copyright>Copyright (c) 2026 Abdullah Lotfy</Copyright>

    <ABAdvToolsProductLogo>$(RepoRoot)assets\logo_128.png</ABAdvToolsProductLogo>
  </PropertyGroup>

  <Import Project="$(RepoRoot)shared\ABAdvTools\build\ABAdvTools.Setup.targets" />

</Project>
